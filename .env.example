# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE CONFIGURATION: Configure these keys via the Secrets panel in AI Studio
# to connect your application to a real Firebase Authentication project.
# If left as placeholders, the app will automatically run in local Demo Mode.
FIREBASE_API_KEY=FIREBASE_API_KEY_PLACEHOLDER
FIREBASE_APPLICATION_ID=FIREBASE_APP_ID_PLACEHOLDER
FIREBASE_PROJECT_ID=FIREBASE_PROJECT_ID_PLACEHOLDER
